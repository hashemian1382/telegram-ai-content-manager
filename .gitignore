# ---- Secrets & environment ----
# Never commit real credentials; .env.example is the only committed template.
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3
instance/

# ---- Tests, linting & coverage ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- Editors & IDEs ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs & archives ----
*.log
*.zip
