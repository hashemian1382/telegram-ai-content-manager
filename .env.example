# =============================================================================
# Telegram AI Content Manager — environment configuration template
# =============================================================================
#
# HOW TO USE
#   1. Copy this file to `.env`:   cp .env.example .env
#      (or just run `./start.sh` — it creates `.env` for you automatically)
#   2. Fill in the values below.
#   3. NEVER commit `.env` to Git — it is already in `.gitignore`.
#
# All variables are optional for local development. The app starts fine with
# only SECRET_KEY set; Telegram and Gemini features light up once you add
# their keys.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Used to sign session cookies. Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development (default): SQLite file created at instance/telegram_ai_content_manager.db
# (the instance/ folder is gitignored).
DATABASE_URL=sqlite:///telegram_ai_content_manager.db

# Production (Render / Neon / Heroku-style PostgreSQL). Both `postgres://` and
# `postgresql://` URLs are normalized automatically for Psycopg 3:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Telegram — only needed for publishing drafts to your channel
# -----------------------------------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Target channel: public @username or numeric chat id. The bot must be an
# administrator of this channel to post.
TELEGRAM_CHANNEL_ID=@your_channel

# -----------------------------------------------------------------------------
# Google Gemini — only needed for AI draft generation
# -----------------------------------------------------------------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated list of models offered in the dashboard UI.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Scraper tuning (optional)
# -----------------------------------------------------------------------------
# How many of the latest public posts to fetch per channel per run.
SCRAPER_LIMIT=10

# HTTP timeout in seconds for each channel scrape.
SCRAPER_TIMEOUT=20
